generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  ACCEPTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies    Company[]
  applications Application[]
  contacts     Contact[]

  @@map("users")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  website   String?
  location  String?
  industry  String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications Application[]
  contacts     Contact[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("companies")
}

model Application {
  id          String            @id @default(uuid())
  jobTitle    String
  jobUrl      String?
  description String?
  status      ApplicationStatus @default(SAVED)
  jobType     JobType?
  workMode    WorkMode?
  location    String?
  salaryMin   Decimal?          @db.Decimal(12, 2)
  salaryMax   Decimal?          @db.Decimal(12, 2)
  currency    String?           @db.VarChar(3)
  appliedAt   DateTime?
  deadline    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  ownerId   String
  companyId String

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  notes         Note[]
  statusHistory StatusHistory[]
  interviews    Interview[]

  @@index([ownerId, status])
  @@index([ownerId, deadline])
  @@index([companyId])
  @@map("applications")
}

model Note {
  id            String   @id @default(uuid())
  content       String
  applicationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("notes")
}

model StatusHistory {
  id            String             @id @default(uuid())
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  applicationId String
  changedAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
  @@map("status_history")
}

model Interview {
  id            String          @id @default(uuid())
  title         String
  scheduledAt   DateTime
  durationMin   Int?
  meetingUrl    String?
  location      String?
  notes         String?
  outcome       String?
  status        InterviewStatus @default(SCHEDULED)
  applicationId String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  jobTitle  String?
  notes     String?
  ownerId   String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([companyId])
  @@map("contacts")
}
